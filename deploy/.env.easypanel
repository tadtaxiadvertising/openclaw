# OpenClaw — EasyPanel Environment Variables
#
# IMPORTANT: Set these in EasyPanel's "Environment Variables" UI, NOT here.
# This file is a TEMPLATE — never put real secrets in files that go to git.
# Add the NVIDIA key directly in EasyPanel's secure env var section.

# ── REQUIRED ──────────────────────────────────────────────────

# Gateway auth token. Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# V8 heap limit — prevents unbounded memory growth on constrained VPS.
# 768m for 1GB VPS, 1536m for 2GB+ VPS.
NODE_OPTIONS=--max-old-space-size=768

# Gateway bind mode — must be "lan" for EasyPanel proxy access
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_GATEWAY_PORT=18789

# Disable Bonjour/mDNS in container
OPENCLAW_DISABLE_BONJOUR=1

# Timezone
OPENCLAW_TZ=UTC

# ── NVIDIA FREE-TIER (SET THIS IN EASYPANEL UI ONLY) ──────────

# Paste your NVIDIA API key directly in EasyPanel's env vars section.
# DO NOT paste the key in this file or any file committed to git.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── NVIDIA FREE MODELS AVAILABLE ──────────────────────────────
# All use OpenAI-compatible API at integrate.api.nvidia.com/v1
#
# Model ID                     | Alias  | Max Tokens | Reasoning
# deepseek-ai/deepseek-v4-flash | flash  | 16384      | yes
# deepseek-ai/deepseek-v4-pro   | pro    | 16384      | yes
# meta/llama-3.3-70b-instruct   | llama  | 1024       | no
# mistralai/mixtral-8x7b-...    | mixtral| 1024       | no
# google/gemma-2-2b-it          | gemma  | 1024       | no
# z-ai/glm-5.2                  | glm    | 16384      | no
# minimaxai/minimax-m3          | m3     | 8192       | no
# minimaxai/minimax-m2.7        | m2     | 8192       | no
# moonshotai/kimi-k2.6          | kimi   | 16384      | no
# sarvamai/sarvam-m             | sarvam | 16384      | no

# ── OPTIONAL PROVIDERS (fallback) ────────────────────────────

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# ── EXTENSIONS ────────────────────────────────────────────────

# OPENCLAW_EXTENSIONS=nvidia

# ── BROWSER ───────────────────────────────────────────────────
# Chromium adds ~300MB image weight + heavy CPU/memory when active.
# Default OFF for constrained VPS. Set to "1" only if browser automation is needed.
OPENCLAW_INSTALL_BROWSER=

# ── CHANNELS ──────────────────────────────────────────────────

# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=xoxb-...
